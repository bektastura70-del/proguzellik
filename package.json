{
  "name": "proguzellik",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @proguzellik/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @proguzellik/api db:seed",
    "db:dev-roles": "pnpm --filter @proguzellik/api db:dev-roles",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml stop"
  },
  "devDependencies": {
    "turbo": "2.5.8",
    "typescript": "5.9.2",
    "@types/node": "22.18.6"
  }
}
