{
  "name": "proguzellik",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @proguzellik/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @proguzellik/api db:seed",
    "db:dev-roles": "pnpm --filter @proguzellik/api db:dev-roles",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml stop",
    "test:e2e": "pnpm --filter @proguzellik/api build && pnpm --filter @proguzellik/web build && pnpm --filter @proguzellik/e2e test:e2e"
  },
  "devDependencies": {
    "turbo": "2.5.8",
    "typescript": "5.9.2",
    "@types/node": "22.18.6"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0",
      "path-to-regexp@8": "^8.4.2",
      "sharp": "^0.35.5",
      "postcss": "^8.5.32",
      "deepmerge-ts": "^8.0.2"
    }
  }
}
