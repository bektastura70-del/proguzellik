# ProGüzellik canlı ortam değişkenleri — /opt/proguzellik/.env (izin 600, sahibi root).
# Gerçek değerleri ASLA depoya koymayın. Tüm parolalar/anahtarlar: openssl rand -hex 32
# (yalnızca hex: veritabanı/Redis adreslerinde özel karakter sorunu çıkmaz)

# Dağıtılan imaj etiketi (git commit kısaltması). Geri dönüşte önceki etikete çevrilir.
APP_VERSION=

PUBLIC_URL=https://proguzellik.com

# PostgreSQL migration sahibi (yalnızca postgres ve migrate servislerine verilir)
PG_OWNER_USER=proguzellik_owner
PG_OWNER_PASSWORD=
PG_DB=proguzellik

# Uygulama rolleri (migration'lar NOLOGIN oluşturur; set-db-role-passwords.sh giriş izni verir)
APP_TENANT_DB_PASSWORD=
APP_PLATFORM_DB_PASSWORD=

REDIS_PASSWORD=

# Değiştirilirse tüm oturumlar düşer
JWT_SECRET=
# DİKKAT: değiştirilir/kaybedilirse mevcut 2FA kayıtları çözülemez. Sunucu dışında ayrıca yedekleyin.
MFA_ENCRYPTION_KEY=

# Herkese açık işletme kaydı. Başlangıçta kapalı (0).
REGISTRATION_ENABLED=0

# Ortak ters vekil ağı (edge-caddy)
EDGE_NETWORK=edge_proxy
