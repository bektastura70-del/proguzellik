{
  "name": "@proguzellik/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.cjs",
    "db:dev-roles": "docker exec -i proguzellik-postgres psql -U proguzellik -d proguzellik -v ON_ERROR_STOP=1 < scripts/dev-db-roles.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "ioredis": "^5.8.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/jest": "^29.5.0",
    "@types/node": "22.18.6",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.16.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "5.9.2"
  }
}
