{
  "appId": "com.proguzellik.app",
  "appName": "Pro Güzellik",
  "webDir": "www",
  "appendUserAgent": "ProGuzellikApp/1.0.0",
  "backgroundColor": "#faf8f5",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "10.0.2.2",
      "http://10.0.2.2:3000"
    ],
    "errorPath": "offline.html",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#faf8f5",
      "showSpinner": false
    },
    "LocalNotifications": {
      "iconColor": "#933c63"
    }
  }
}
