// ProGüzellik veri modeli.
// Kiracıya (işletmeye) ait her tablo "tenantId" taşır ve PostgreSQL RLS ile korunur.
// RLS politikaları migration SQL'lerinde tanımlıdır (bkz. prisma/migrations/*_rls*).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum Role {
  OWNER
  MANAGER
  RECEPTION
  STAFF
}

model Tenant {
  id                   String        @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String        @unique
  status               TenantStatus  @default(TRIAL)
  planCode             PlanCode      @default(PROFESSIONAL)
  trialEndsAt          DateTime?
  onlineBookingEnabled Boolean       @default(true)
  requireMfa           Boolean       @default(false)
  pastDueSince         DateTime?
  limitExceededAt      DateTime?
  phone                String?
  email                String?
  address              String?
  timezone             String        @default("Europe/Istanbul")
  suspendedAt          DateTime?
  suspendedReason      String?
  suspendedFromStatus  TenantStatus?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  memberships   Membership[]
  invites       TenantInvite[]
  auditLogs     AuditLog[]
  customers     Customer[]
  categories    ServiceCategory[]
  services      Service[]
  staff         StaffMember[]
  plan          Plan              @relation(fields: [planCode], references: [code])
  subscriptions Subscription[]
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String
  fullName            String
  phone               String?
  isPlatformAdmin     Boolean   @default(false)
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  emailVerifiedAt     DateTime?
  mfaSecretEnc        String?
  mfaPendingSecretEnc String?
  mfaEnabledAt        DateTime?
  mfaLastStep         Int?
  mfaFailedAttempts   Int       @default(0)
  failedLogins        Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  authTokens    AuthToken[]
  recoveryCodes RecoveryCode[]
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

// Yalnızca ekleme yapılabilir (UPDATE/DELETE yetkisi verilmez).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------
// Müşteri CRM
// ---------------------------------------------------------------------
model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  firstName        String
  lastName         String
  phone            String?
  email            String?
  birthDate        DateTime? @db.Date
  gender           String?
  notes            String?
  tags             String[]  @default([])
  source           String?
  kvkkConsentAt    DateTime?
  marketingConsent Boolean   @default(false)
  anonymizedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerNotes CustomerNote[]
  appointments  Appointment[]
  packages      CustomerPackage[]
  transactions  FinanceTransaction[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, lastName, firstName])
}

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  customerId String   @db.Uuid
  authorId   String?  @db.Uuid
  body       String
  createdAt  DateTime @default(now())

  // Bileşik yabancı anahtar: not ancak aynı işletmenin müşterisine bağlanabilir.
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

// ---------------------------------------------------------------------
// Hizmetler, personel, çalışma saatleri, randevular
// ---------------------------------------------------------------------
model ServiceCategory {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  name      String
  sortOrder Int    @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  categoryId     String?  @db.Uuid
  name           String
  description    String?
  durationMin    Int
  price          Decimal  @db.Decimal(12, 2)
  color          String?
  isActive       Boolean  @default(true)
  onlineBookable Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         ServiceCategory?    @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  staff            StaffService[]
  appointments     Appointment[]
  packageTemplates PackageTemplate[]
  customerPackages CustomerPackage[]
  consumables      ServiceConsumable[]

  @@unique([tenantId, id])
}

model StaffMember {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  userId         String?  @db.Uuid
  displayName    String
  title          String?
  phone          String?
  color          String?
  commissionRate Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  onlineBookable Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services     StaffService[]
  workingHours WorkingHour[]
  timeOff      TimeOff[]
  appointments Appointment[]
  transactions FinanceTransaction[]

  @@unique([tenantId, id])
}

model StaffService {
  tenantId  String @db.Uuid
  staffId   String @db.Uuid
  serviceId String @db.Uuid

  staff   StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  service Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

// weekday: 0=Pazar ... 6=Cumartesi; dakika cinsinden gün içi saat (09:00 = 540)
model WorkingHour {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  staffId  String @db.Uuid
  weekday  Int
  startMin Int
  endMin   Int

  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, staffId])
}

model TimeOff {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  staffId  String   @db.Uuid
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, staffId, startsAt])
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  PANEL
  ONLINE
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  customerId        String            @db.Uuid
  staffId           String            @db.Uuid
  serviceId         String            @db.Uuid
  startsAt          DateTime
  endsAt            DateTime
  status            AppointmentStatus @default(BOOKED)
  price             Decimal           @db.Decimal(12, 2)
  source            BookingSource     @default(PANEL)
  notes             String?
  cancelReason      String?
  customerPackageId String?           @db.Uuid
  createdById       String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer        Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  staff           StaffMember          @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  service         Service              @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  customerPackage CustomerPackage?     @relation(fields: [tenantId, customerPackageId], references: [tenantId, id], onDelete: Restrict)
  sessionUsage    SessionUsage?
  transactions    FinanceTransaction[]

  @@unique([tenantId, id])
  @@index([tenantId, startsAt])
  @@index([tenantId, staffId, startsAt])
  @@index([tenantId, customerId])
}

// ---------------------------------------------------------------------
// Paket ve seans yönetimi
// ---------------------------------------------------------------------
model PackageTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  serviceId    String   @db.Uuid
  name         String
  sessionCount Int
  price        Decimal  @db.Decimal(12, 2)
  validityDays Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  service  Service           @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  packages CustomerPackage[]

  @@unique([tenantId, id])
}

enum PackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model CustomerPackage {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  customerId    String        @db.Uuid
  templateId    String?       @db.Uuid
  serviceId     String        @db.Uuid
  name          String
  totalSessions Int
  usedSessions  Int           @default(0)
  price         Decimal       @db.Decimal(12, 2)
  status        PackageStatus @default(ACTIVE)
  purchasedAt   DateTime      @default(now())
  expiresAt     DateTime?
  createdById   String?       @db.Uuid

  customer     Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  template     PackageTemplate?     @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  service      Service              @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  usages       SessionUsage[]
  appointments Appointment[]
  transactions FinanceTransaction[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
}

model SessionUsage {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  customerPackageId String   @db.Uuid
  appointmentId     String?  @db.Uuid
  staffId           String?  @db.Uuid
  note              String?
  usedAt            DateTime @default(now())

  customerPackage CustomerPackage @relation(fields: [tenantId, customerPackageId], references: [tenantId, id], onDelete: Cascade)
  appointment     Appointment?    @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, appointmentId])
  @@index([tenantId, customerPackageId])
}

// ---------------------------------------------------------------------
// Kasa: gelir, gider, tahsilat, iade, prim ödemeleri
// Kayıtlar değiştirilemez/silinemez; düzeltmeler ters kayıtla yapılır.
// ---------------------------------------------------------------------
enum TransactionType {
  INCOME
  EXPENSE
  REFUND
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model FinanceTransaction {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  type              TransactionType
  category          String
  amount            Decimal         @db.Decimal(12, 2)
  method            PaymentMethod
  customerId        String?         @db.Uuid
  appointmentId     String?         @db.Uuid
  customerPackageId String?         @db.Uuid
  staffId           String?         @db.Uuid
  refundOfId        String?         @db.Uuid
  description       String?
  occurredAt        DateTime        @default(now())
  createdById       String?         @db.Uuid
  createdAt         DateTime        @default(now())

  customer        Customer?            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  appointment     Appointment?         @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  customerPackage CustomerPackage?     @relation(fields: [tenantId, customerPackageId], references: [tenantId, id], onDelete: Restrict)
  staff           StaffMember?         @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  refundOf        FinanceTransaction?  @relation("Refunds", fields: [tenantId, refundOfId], references: [tenantId, id], onDelete: Restrict)
  refunds         FinanceTransaction[] @relation("Refunds")

  @@unique([tenantId, id])
  @@index([tenantId, occurredAt])
  @@index([tenantId, customerId])
}

// ---------------------------------------------------------------------
// Stok ve sarf malzemeleri
// ---------------------------------------------------------------------
enum ProductKind {
  RETAIL
  CONSUMABLE
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  CONSUME
  SALE
}

model Product {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  name      String
  sku       String?
  unit      String      @default("adet")
  kind      ProductKind @default(CONSUMABLE)
  stockQty  Decimal     @default(0) @db.Decimal(12, 3)
  minQty    Decimal     @default(0) @db.Decimal(12, 3)
  costPrice Decimal?    @db.Decimal(12, 2)
  salePrice Decimal?    @db.Decimal(12, 2)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  movements   StockMovement[]
  consumables ServiceConsumable[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
}

// Yalnızca ekleme yapılabilir; stok düzeltmeleri ADJUST hareketiyle yapılır.
model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  productId     String            @db.Uuid
  type          StockMovementType
  qty           Decimal           @db.Decimal(12, 3)
  note          String?
  appointmentId String?           @db.Uuid
  createdById   String?           @db.Uuid
  createdAt     DateTime          @default(now())

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, productId, createdAt])
}

model ServiceConsumable {
  tenantId  String  @db.Uuid
  serviceId String  @db.Uuid
  productId String  @db.Uuid
  qty       Decimal @db.Decimal(12, 3)

  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@id([serviceId, productId])
}

// ---------------------------------------------------------------------
// SaaS abonelik paketleri
// ---------------------------------------------------------------------
enum PlanCode {
  STARTER
  PROFESSIONAL
  SMART
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// Global paket tanımları (kiracıya ait değil, herkes okuyabilir).
model Plan {
  code         PlanCode @id
  name         String
  maxStaff     Int
  monthlyPrice Decimal  @db.Decimal(12, 2)
  yearlyPrice  Decimal  @db.Decimal(12, 2)
  features     String[]
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)

  tenants       Tenant[]
  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  planCode           PlanCode
  billingCycle       BillingCycle
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  provider           String
  providerRef        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planCode], references: [code])
  payments SubscriptionPayment[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model SubscriptionPayment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  subscriptionId String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  status         String
  provider       String
  providerRef    String?
  description    String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------
// Bildirimler (WhatsApp Cloud API; yerelde test sağlayıcısı)
// ---------------------------------------------------------------------
enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  channel           String             @default("WHATSAPP")
  recipient         String
  template          String
  payload           Json
  status            NotificationStatus @default(QUEUED)
  appointmentId     String?            @db.Uuid
  scheduledFor      DateTime           @default(now())
  providerMessageId String?            @unique
  error             String?
  attempts          Int                @default(0)
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, appointmentId])
}

// ---------------------------------------------------------------------
// Kimlik doğrulama: oturumlar, tek kullanımlık belirteçler, 2FA kurtarma kodları
// (kiracıya ait değil; yalnızca platform rolü erişir)
// ---------------------------------------------------------------------
model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  ip          String?
  userAgent   String?
  mfaVerified Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Kayıtlı ödeme yöntemi: yalnızca sağlayıcı belirteci (kart verisi asla saklanmaz).
model SavedPaymentMethod {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  provider  String
  token     String
  label     String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/// Gönderilen e-postaların kaydı. Test modunda gövde saklanır; gerçek modda saklanmaz.
model OutboundEmail {
  id                String    @id @default(uuid()) @db.Uuid
  to                String
  template          String
  subject           String
  body              String?
  status            String
  provider          String
  providerMessageId String?
  dedupeKey         String?   @unique
  error             String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  @@index([to, createdAt])
}

/// Zamanlanmış görev çalıştırma kaydı (aynı gün ikinci kez çalışmayı önler).
model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  runKey     String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  result     Json?
  error      String?

  @@unique([name, runKey])
}

// ---------------------------------------------------------------------
// İşletme daveti (SaaS sahibi panelinden). Belirteç yalnızca özet (SHA-256) olarak saklanır.
// PENDING_DELIVERY: e-posta gönderilemiyor (canlıda SMTP yok) — belirteç hiç üretilmez.
// ---------------------------------------------------------------------
enum InviteStatus {
  PENDING_DELIVERY
  SENT
  ACCEPTED
  REVOKED
}

model TenantInvite {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  email          String
  fullName       String
  role           Role         @default(OWNER)
  status         InviteStatus @default(PENDING_DELIVERY)
  tokenHash      String?      @unique
  expiresAt      DateTime?
  sentAt         DateTime?
  sendCount      Int          @default(0)
  acceptedAt     DateTime?
  acceptedUserId String?      @db.Uuid
  revokedAt      DateTime?
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([email])
}
