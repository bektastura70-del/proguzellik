# Kopyalayın: cp .env.example .env  (gerçek değerleri commit etmeyin)
# Migration sahibi (yalnızca prisma migrate için)
DATABASE_URL=postgresql://proguzellik:proguzellik_dev@127.0.0.1:5435/proguzellik
# Uygulama rolleri (RLS uygulanır / platform)
APP_DATABASE_URL=postgresql://app_tenant:app_tenant_dev@127.0.0.1:5435/proguzellik
PLATFORM_DATABASE_URL=postgresql://app_platform:app_platform_dev@127.0.0.1:5435/proguzellik
REDIS_URL=redis://127.0.0.1:6381
# En az 32 karakter. Üretmek için: openssl rand -hex 32
JWT_SECRET=
# 2FA gizli anahtarlarını şifreler. Üretmek için: openssl rand -hex 32  (değiştirilirse mevcut 2FA kayıtları çözülemez)
MFA_ENCRYPTION_KEY=
MFA_ENFORCE_PLATFORM=1
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=120
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Güvenilir ters vekil (nginx, yük dengeleyici) arkasında 1; doğrudan internete açıksa 0
TRUST_PROXY=1
# Bağlantılarda kullanılacak web adresi (e-postalardaki linkler)
APP_URL=http://localhost:3000

# E-posta: mock = gönderilmez (kayıt + log), smtp = SMTP_URL ile gönderilir
EMAIL_MODE=mock
SMTP_URL=
EMAIL_FROM=ProGüzellik <no-reply@proguzellik.local>
# İşletmelerin abonelik için yazacağı kurumsal adres
SUPPORT_EMAIL=info@proguzellik.com

# Ödeme: yalnızca test sağlayıcısı (gerçek tahsilat yok)
PAYMENT_MODE=mock

# WhatsApp: mock = gönderilmez; cloud = Meta Cloud API
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Yapay zekâ asistanı: mock = yerel kural tabanlı; anthropic = Claude API (ANTHROPIC_API_KEY gerekir)
AI_MODE=mock

# Herkese açık işletme kaydı: tanımsızsa canlıda (NODE_ENV=production) KAPALI, geliştirmede açık. 1 = aç, 0 = kapat
# REGISTRATION_ENABLED=
# Paket fiyatları herkese açık mı? Tanımsızsa canlıda kapalı (0), diğer ortamlarda açık.
# PRICING_PUBLIC=

# Zamanlanmış görevler (günlük abonelik kontrolü, İstanbul saatiyle)
JOBS_ENABLED=1
JOBS_CRON=0 3 * * *
BILLING_GRACE_DAYS=7
QUEUE_PREFIX=proguzellik
