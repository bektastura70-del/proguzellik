# Kopyalayın: cp .env.example .env  (gerçek değerleri commit etmeyin)
# Migration sahibi (yalnızca prisma migrate için)
DATABASE_URL=postgresql://proguzellik:proguzellik_dev@127.0.0.1:5435/proguzellik
# Uygulama rolleri (RLS uygulanır / platform)
APP_DATABASE_URL=postgresql://app_tenant:app_tenant_dev@127.0.0.1:5435/proguzellik
PLATFORM_DATABASE_URL=postgresql://app_platform:app_platform_dev@127.0.0.1:5435/proguzellik
REDIS_URL=redis://127.0.0.1:6381
# En az 32 karakter. Üretmek için: openssl rand -hex 32
JWT_SECRET=
# 2FA gizli anahtarlarını şifreler. Üretmek için: openssl rand -hex 32  (değiştirilirse mevcut 2FA kayıtları çözülemez)
MFA_ENCRYPTION_KEY=
MFA_ENFORCE_PLATFORM=1
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=120
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Güvenilir ters vekil (nginx, yük dengeleyici) arkasında 1; doğrudan internete açıksa 0
TRUST_PROXY=1
# Bağlantılarda kullanılacak web adresi (e-postalardaki linkler)
APP_URL=http://localhost:3000

# E-posta: mock = gönderilmez (kayıt + log), smtp = SMTP_URL ile gönderilir
EMAIL_MODE=mock
SMTP_URL=
EMAIL_FROM=ProGüzellik <no-reply@proguzellik.local>
# İşletmelerin abonelik için yazacağı kurumsal adres
SUPPORT_EMAIL=info@proguzellik.com

# Ödeme: yalnızca test sağlayıcısı (gerçek tahsilat yok)
PAYMENT_MODE=mock
# iyzico Abonelik (yalnız SANDBOX; canlıda NODE_ENV=production iken ödeme kapalı kalır). Bkz. docs/iyzico-odeme.md
# PAYMENT_MODE=iyzico
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# IYZICO_MERCHANT_ID=
# IYZICO_CALLBACK_BASE=http://localhost:3000

# WhatsApp: mock = gönderilmez; cloud = Meta Cloud API
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Yapay zekâ asistanı: mock = yerel kural tabanlı; anthropic = Claude API (ANTHROPIC_API_KEY gerekir);
# openai = gelen mesajları OpenAI yanıtlar (OPENAI_API_KEY ve OPENAI_MODEL gerekir; model adı resmi belgeden seçilir)
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=
# Boşsa "low". Modele göre desteklenen değerler değişir (resmi belge).
OPENAI_REASONING_EFFORT=
# AI_MODE=anthropic iken zorunlu (varsayılan yok): tek ortak model, ör. claude-haiku-5-5. ANTHROPIC_API_KEY de gerekir.
AI_MODEL=
# Sahip asistanı (Sorular): mock | anthropic. Sohbet modelinden bağımsız açılır; anthropic için AI_MODEL ve anahtar gerekir.
ASSISTANT_AI_MODE=mock
# Kullanım hakkı: off = yalnız kayıt, shadow = hak düşer ama yanıt kesilmez, enforce = hak bitince personele devreder
AI_QUOTA_MODE=off
# Canlıda gerçek yapay zekâ yalnız bu işletme adreslerinde (virgülle, ör. deneme); * = hepsi. Geliştirmede her yerde açık.
AI_PILOT_TENANTS=
# 1 = tüm yapay zekâ yanıtlarını hemen durdur (acil durum)
AI_GLOBAL_PAUSE=0
# Fiyat tablosunda olmayan model için USD/milyon token: girdi,çıktı,önbellek okuma,önbellek yazma
AI_PRICE_USD_PER_MTOK=
# Yapay zekâ ek paket satışı: tanımsızsa canlıda kapalı, geliştirmede açık
AI_TOPUP_ENABLED=

# Herkese açık işletme kaydı: tanımsızsa canlıda (NODE_ENV=production) KAPALI, geliştirmede açık. 1 = aç, 0 = kapat
# REGISTRATION_ENABLED=
# Online satın alma ve otomatik yenileme: tanımsızsa canlıda kapalı, diğer ortamlarda açık. 0 = acil durum, sitedeki tüm tutarları gizler.
# Sitede tutar yalnız SaaS sahibinin panelden onayladığı (parola + 2FA) fiyat sürümünden gösterilir.
# PRICING_PUBLIC=

# Zamanlanmış görevler (günlük abonelik kontrolü, İstanbul saatiyle)
JOBS_ENABLED=1
JOBS_CRON=0 3 * * *
BILLING_GRACE_DAYS=7
QUEUE_PREFIX=proguzellik

# PWA V1.0 (salon uygulaması ve anlık bildirim). Tanımsızsa canlıda KAPALI, yerelde açık.
# PWA_ENABLED=1
# WEB_PUSH_MODE=off|mock|live   (tanımsız: canlıda off, yerelde mock = ağ isteği yok)
# Anahtar üretimi: node -e 'console.log(require("web-push").generateVAPIDKeys())'
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:destek@ornek.com

# Yenilenme hatırlatması (hizmet tekrar süresi dolmadan müşteriye bildirim + e-posta). Tanımsızsa her ortamda KAPALI.
# RENEWAL_REMINDERS=1
