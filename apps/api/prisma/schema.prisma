// ProGüzellik veri modeli.
// Kiracıya (işletmeye) ait her tablo "tenantId" taşır ve PostgreSQL RLS ile korunur.
// RLS politikaları migration SQL'lerinde tanımlıdır (bkz. prisma/migrations/*_rls*).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum Role {
  OWNER
  MANAGER
  RECEPTION
  STAFF
}

model Tenant {
  id                      String        @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String        @unique
  status                  TenantStatus  @default(TRIAL)
  planCode                String        @default("PROFESSIONAL")
  trialEndsAt             DateTime?
  onlineBookingEnabled    Boolean       @default(true)
  requireMfa              Boolean       @default(false)
  pastDueSince            DateTime?
  limitExceededAt         DateTime?
  phone                   String?
  email                   String?
  address                 String?
  timezone                String        @default("Europe/Istanbul")
  /// Süreli paket bitimine kaç gün kala müşteriye hatırlatma planlanır (WhatsApp)
  packageReminderDays     Int           @default(7)
  /// Yenilenme hatırlatması (uygulama bildirimi + e-posta) bu işletmede açık mı? Ortamda RENEWAL_REMINDERS=1 de gerekir.
  renewalRemindersEnabled Boolean       @default(false)
  /// Kritik stok e-postası (işletme sahibi ve yöneticilere günlük özet)
  lowStockEmailEnabled    Boolean       @default(true)
  /// SaaS sahibi bu işletmede yenilenme hatırlatmasına izin verdi mi (pilot). İşletme kendi ayarını yalnızca izin varsa açabilir.
  renewalRemindersAllowed Boolean       @default(false)
  suspendedAt             DateTime?
  suspendedReason         String?
  suspendedFromStatus     TenantStatus?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  memberships       Membership[]
  invites           TenantInvite[]
  auditLogs         AuditLog[]
  customers         Customer[]
  categories        ServiceCategory[]
  services          Service[]
  staff             StaffMember[]
  plan              Plan                  @relation(fields: [planCode], references: [code])
  subscriptions     Subscription[]
  billingProfile    TenantBillingProfile?
  ledgerEntries     PlatformLedgerEntry[]
  invoices          PlatformInvoice[]
  pwaSettings       TenantPwaSettings?
  assets            TenantAsset[]
  identities        CustomerIdentity[]
  trialApplications TrialApplication[]
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String
  fullName            String
  phone               String?
  isPlatformAdmin     Boolean   @default(false)
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  emailVerifiedAt     DateTime?
  mfaSecretEnc        String?
  mfaPendingSecretEnc String?
  mfaEnabledAt        DateTime?
  mfaLastStep         Int?
  mfaFailedAttempts   Int       @default(0)
  failedLogins        Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  authTokens    AuthToken[]
  recoveryCodes RecoveryCode[]
  consents      UserConsent[]
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

// Yalnızca ekleme yapılabilir (UPDATE/DELETE yetkisi verilmez).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------
// Müşteri CRM
// ---------------------------------------------------------------------
model Customer {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @db.Uuid
  firstName                String
  lastName                 String
  phone                    String?
  email                    String?
  birthDate                DateTime? @db.Date
  gender                   String?
  notes                    String?
  tags                     String[]  @default([])
  source                   String?
  kvkkConsentAt            DateTime?
  marketingConsent         Boolean   @default(false)
  /// Müşteri yenilenme hatırlatmalarını kapattıysa (vazgeçme) zamanı; boşsa kapatmamış
  renewalRemindersOptOutAt DateTime?
  anonymizedAt             DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerNotes CustomerNote[]
  appointments  Appointment[]
  packages      CustomerPackage[]
  transactions  FinanceTransaction[]
  productSales  ProductSale[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, lastName, firstName])
}

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  customerId String   @db.Uuid
  authorId   String?  @db.Uuid
  body       String
  createdAt  DateTime @default(now())

  // Bileşik yabancı anahtar: not ancak aynı işletmenin müşterisine bağlanabilir.
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

// ---------------------------------------------------------------------
// Hizmetler, personel, çalışma saatleri, randevular
// ---------------------------------------------------------------------
model ServiceCategory {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  name      String
  sortOrder Int    @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model Service {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @db.Uuid
  categoryId              String?  @db.Uuid
  name                    String
  description             String?
  durationMin             Int
  price                   Decimal  @db.Decimal(12, 2)
  color                   String?
  isActive                Boolean  @default(true)
  onlineBookable          Boolean  @default(true)
  /// Tamamlanan randevudan kaç gün sonra "tekrar randevu" hatırlatması yapılır (boşsa yapılmaz)
  rebookAfterDays         Int?
  /// Yenilenme tarihinden (son işlem + rebookAfterDays) kaç gün önce müşteriye hatırlatma gider (boşsa gitmez)
  renewalRemindDaysBefore Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         ServiceCategory?    @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  staff            StaffService[]
  appointments     Appointment[]
  packageTemplates PackageTemplate[]
  customerPackages CustomerPackage[]
  consumables      ServiceConsumable[]

  @@unique([tenantId, id])
}

model StaffMember {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  userId                String?  @db.Uuid
  displayName           String
  title                 String?
  phone                 String?
  color                 String?
  commissionRate        Decimal  @default(0) @db.Decimal(5, 2)
  /// Ürün satışlarından prim oranı (%)
  productCommissionRate Decimal  @default(0) @db.Decimal(5, 2)
  isActive              Boolean  @default(true)
  onlineBookable        Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services     StaffService[]
  workingHours WorkingHour[]
  timeOff      TimeOff[]
  appointments Appointment[]
  transactions FinanceTransaction[]
  productSales ProductSale[]

  @@unique([tenantId, id])
}

model StaffService {
  tenantId  String @db.Uuid
  staffId   String @db.Uuid
  serviceId String @db.Uuid

  staff   StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  service Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

// weekday: 0=Pazar ... 6=Cumartesi; dakika cinsinden gün içi saat (09:00 = 540)
model WorkingHour {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  staffId  String @db.Uuid
  weekday  Int
  startMin Int
  endMin   Int

  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, staffId])
}

model TimeOff {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  staffId  String   @db.Uuid
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, staffId, startsAt])
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  PANEL
  ONLINE
  WHATSAPP
  INSTAGRAM
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  customerId        String            @db.Uuid
  staffId           String            @db.Uuid
  serviceId         String            @db.Uuid
  startsAt          DateTime
  endsAt            DateTime
  status            AppointmentStatus @default(BOOKED)
  price             Decimal           @db.Decimal(12, 2)
  source            BookingSource     @default(PANEL)
  notes             String?
  cancelReason      String?
  customerPackageId String?           @db.Uuid
  createdById       String?           @db.Uuid
  /// Müşteri portalında doğrulanmış kimlikle alındıysa (PWA V1.0)
  portalIdentityId  String?           @db.Uuid
  /// Tekrar gönderilen online rezervasyon isteği aynı randevuyu döndürür (Idempotency-Key)
  idempotencyKey    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer        Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  staff           StaffMember          @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  service         Service              @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  customerPackage CustomerPackage?     @relation(fields: [tenantId, customerPackageId], references: [tenantId, id], onDelete: Restrict)
  sessionUsage    SessionUsage?
  transactions    FinanceTransaction[]
  productSales    ProductSale[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, startsAt])
  @@index([tenantId, staffId, startsAt])
  @@index([tenantId, customerId])
  @@index([tenantId, portalIdentityId])
}

// ---------------------------------------------------------------------
// Paket ve seans yönetimi
// ---------------------------------------------------------------------
model PackageTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  serviceId    String   @db.Uuid
  name         String
  sessionCount Int
  price        Decimal  @db.Decimal(12, 2)
  validityDays Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  service  Service           @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  packages CustomerPackage[]

  @@unique([tenantId, id])
}

enum PackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model CustomerPackage {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  customerId    String        @db.Uuid
  templateId    String?       @db.Uuid
  serviceId     String        @db.Uuid
  name          String
  totalSessions Int
  usedSessions  Int           @default(0)
  price         Decimal       @db.Decimal(12, 2)
  status        PackageStatus @default(ACTIVE)
  purchasedAt   DateTime      @default(now())
  expiresAt     DateTime?
  createdById   String?       @db.Uuid

  customer     Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  template     PackageTemplate?     @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  service      Service              @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  usages       SessionUsage[]
  appointments Appointment[]
  transactions FinanceTransaction[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
}

model SessionUsage {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  customerPackageId String   @db.Uuid
  appointmentId     String?  @db.Uuid
  staffId           String?  @db.Uuid
  note              String?
  usedAt            DateTime @default(now())

  customerPackage CustomerPackage @relation(fields: [tenantId, customerPackageId], references: [tenantId, id], onDelete: Cascade)
  appointment     Appointment?    @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, appointmentId])
  @@index([tenantId, customerPackageId])
}

// ---------------------------------------------------------------------
// Kasa: gelir, gider, tahsilat, iade, prim ödemeleri
// Kayıtlar değiştirilemez/silinemez; düzeltmeler ters kayıtla yapılır.
// ---------------------------------------------------------------------
enum TransactionType {
  INCOME
  EXPENSE
  REFUND
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model FinanceTransaction {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  type              TransactionType
  category          String
  amount            Decimal         @db.Decimal(12, 2)
  method            PaymentMethod
  customerId        String?         @db.Uuid
  appointmentId     String?         @db.Uuid
  customerPackageId String?         @db.Uuid
  staffId           String?         @db.Uuid
  refundOfId        String?         @db.Uuid
  description       String?
  occurredAt        DateTime        @default(now())
  createdById       String?         @db.Uuid
  createdAt         DateTime        @default(now())

  customer        Customer?            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  appointment     Appointment?         @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  customerPackage CustomerPackage?     @relation(fields: [tenantId, customerPackageId], references: [tenantId, id], onDelete: Restrict)
  staff           StaffMember?         @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  refundOf        FinanceTransaction?  @relation("Refunds", fields: [tenantId, refundOfId], references: [tenantId, id], onDelete: Restrict)
  refunds         FinanceTransaction[] @relation("Refunds")
  productSale     ProductSale?
  productReturns  ProductSaleReturn[]

  @@unique([tenantId, id])
  @@index([tenantId, occurredAt])
  @@index([tenantId, customerId])
}

// ---------------------------------------------------------------------
// Stok ve sarf malzemeleri
// ---------------------------------------------------------------------
enum ProductKind {
  RETAIL
  CONSUMABLE
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  CONSUME
  SALE
  RETURN
}

model Product {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  name      String
  sku       String?
  unit      String      @default("adet")
  kind      ProductKind @default(CONSUMABLE)
  stockQty  Decimal     @default(0) @db.Decimal(12, 3)
  minQty    Decimal     @default(0) @db.Decimal(12, 3)
  costPrice Decimal?    @db.Decimal(12, 2)
  /// KDV dahil satış fiyatı
  salePrice Decimal?    @db.Decimal(12, 2)
  /// KDV oranı (%). İşletme girer; varsayılan oran yoktur.
  vatRate   Decimal?    @db.Decimal(5, 2)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  movements   StockMovement[]
  consumables ServiceConsumable[]
  saleItems   ProductSaleItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
}

// Yalnızca ekleme yapılabilir; stok düzeltmeleri ADJUST hareketiyle yapılır.
model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  productId     String            @db.Uuid
  type          StockMovementType
  qty           Decimal           @db.Decimal(12, 3)
  note          String?
  appointmentId String?           @db.Uuid
  productSaleId String?           @db.Uuid
  createdById   String?           @db.Uuid
  createdAt     DateTime          @default(now())

  product     Product      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productSale ProductSale? @relation(fields: [tenantId, productSaleId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, productId, createdAt])
}

model ServiceConsumable {
  tenantId  String  @db.Uuid
  serviceId String  @db.Uuid
  productId String  @db.Uuid
  qty       Decimal @db.Decimal(12, 3)

  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@id([serviceId, productId])
}

// ---------------------------------------------------------------------
// SaaS abonelik paketleri
// ---------------------------------------------------------------------
enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// PROVIDER: ödeme sağlayıcısıyla tahsil edilen abonelik. MANUAL: SaaS sahibinin elle tanımladığı (tahsilat değildir).
enum SubscriptionSource {
  PROVIDER
  MANUAL
}

enum SubscriptionGrantAction {
  CREATED
  EXTENDED
  RENEWED
  PLAN_CHANGED
  CANCELLED
}

/// Global paket tanımları (kiracıya ait değil, herkes okuyabilir).
model Plan {
  code                   String   @id
  name                   String
  /// Tanıtım sitesinde ve panelde gösterilen kısa açıklama
  description            String?
  maxStaff               Int
  /// Kullanım sınırları; null = sınırsız
  maxCustomers           Int?
  maxMonthlyAppointments Int?
  /// ESKİ (kullanılmaz): fiyatlar PlanPrice sürümlerinden okunur. Sütun geriye dönük uyum için korunur.
  monthlyPrice           Decimal  @db.Decimal(12, 2)
  /// ESKİ (kullanılmaz): bkz. monthlyPrice
  yearlyPrice            Decimal  @db.Decimal(12, 2)
  features               String[]
  /// Pasif paket hiçbir işletmeye yeni atanamaz
  isActive               Boolean  @default(true)
  /// false = gizli: tanıtım sitesinde ve kayıtta görünmez, yalnız SaaS sahibi atayabilir
  isPublic               Boolean  @default(true)
  sortOrder              Int      @default(0)

  tenants       Tenant[]
  subscriptions Subscription[]
  grants        SubscriptionGrant[]
  prices        PlanPrice[]
}

enum PlanPriceStatus {
  DRAFT
  APPROVED
  CANCELLED
}

/// Mevcut aboneliklere etkisi
enum PlanPriceRenewalPolicy {
  /// Mevcut abonelikler kilitli fiyatlarıyla devam eder; yeni fiyat yalnız yeni aboneliklere uygulanır
  KEEP_EXISTING
  /// Mevcut abonelikler, renewalsFrom tarihinde ya da sonrasında başlayan ilk yenileme döneminden itibaren yeni fiyata geçer
  APPLY_ON_RENEWAL
}

/// Paket fiyat sürümü (fiyat geçmişi). Onaylanan sürüm değiştirilemez; yalnız yürürlüğe girmeden iptal edilebilir.
model PlanPrice {
  id            String                 @id @default(uuid()) @db.Uuid
  planCode      String
  /// Onay sırası (onaylanınca verilir); büyük olan, aynı anda yürürlükteki sürümler arasında geçerlidir
  version       Int?
  /// KDV hariç
  monthlyPrice  Decimal                @db.Decimal(12, 2)
  /// KDV hariç
  yearlyPrice   Decimal                @db.Decimal(12, 2)
  vatRate       Decimal                @db.Decimal(5, 2)
  /// Yeni satışlarda geçerli olmaya başladığı an (geçmişe dönük olamaz)
  effectiveFrom DateTime
  renewalPolicy PlanPriceRenewalPolicy
  renewalsFrom  DateTime?
  status        PlanPriceStatus        @default(DRAFT)
  note          String?
  createdById   String?                @db.Uuid
  createdAt     DateTime               @default(now())
  approvedById  String?                @db.Uuid
  approvedAt    DateTime?
  cancelledById String?                @db.Uuid
  cancelledAt   DateTime?
  cancelReason  String?

  plan          Plan           @relation(fields: [planCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  subscriptions Subscription[]

  @@unique([planCode, version])
  @@index([planCode, status])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  planCode           String
  billingCycle       BillingCycle
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  provider           String
  providerRef        String?
  source             SubscriptionSource @default(PROVIDER)
  /// Manuel abonelikte ücretsiz (hediye) mi? Gelir/MRR hesabına girmez.
  isComplimentary    Boolean            @default(false)
  /// Kilitli fiyat: aboneliğin bağlı olduğu onaylı fiyat sürümü ve dönem başına KDV hariç tutar
  planPriceId        String?            @db.Uuid
  priceAmount        Decimal?           @db.Decimal(12, 2)
  vatRate            Decimal?           @db.Decimal(5, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          Plan                  @relation(fields: [planCode], references: [code])
  planPrice     PlanPrice?            @relation(fields: [planPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payments      SubscriptionPayment[]
  grants        SubscriptionGrant[]
  ledgerEntries PlatformLedgerEntry[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([planPriceId])
}

model SubscriptionPayment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  subscriptionId String   @db.Uuid
  /// Tahsil edilen tutar (KDV dahil)
  amount         Decimal  @db.Decimal(12, 2)
  /// KDV hariç tutar ve oran (fiyat sürümüyle yapılan tahsilatlarda)
  netAmount      Decimal? @db.Decimal(12, 2)
  vatRate        Decimal? @db.Decimal(5, 2)
  status         String
  provider       String
  providerRef    String?
  description    String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// SaaS sahibinin manuel abonelik işlemleri defteri. Gerçek tahsilat (SubscriptionPayment) DEĞİLDİR;
/// yalnızca eklenebilir, değiştirilemez/silinemez.
model SubscriptionGrant {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @db.Uuid
  subscriptionId    String                  @db.Uuid
  action            SubscriptionGrantAction
  planCode          String
  periodStart       DateTime?
  periodEnd         DateTime?
  previousPeriodEnd DateTime?
  previousPlanCode  String?
  /// Owner'ın kayda geçirdiği anlaşılan tutar (bilgi amaçlı, tahsilat değildir).
  agreedAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  isComplimentary   Boolean                 @default(false)
  note              String
  actorId           String                  @db.Uuid
  /// İstemcinin her işlem için ürettiği kimlik; tekrar istekte işlem ikinci kez uygulanmaz.
  requestId         String                  @unique
  createdAt         DateTime                @default(now())

  subscription Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planCode], references: [code], onUpdate: Restrict)

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------
// Bildirimler (WhatsApp Cloud API; yerelde test sağlayıcısı)
// ---------------------------------------------------------------------
enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  channel           String             @default("WHATSAPP")
  recipient         String
  template          String
  payload           Json
  status            NotificationStatus @default(QUEUED)
  appointmentId     String?            @db.Uuid
  scheduledFor      DateTime           @default(now())
  providerMessageId String?            @unique
  error             String?
  attempts          Int                @default(0)
  sentAt            DateTime?
  /// SERVICE: hizmet bildirimi (randevu, paket) · MARKETING: ticari ileti (yalnızca açık rızalı müşteriye)
  kind              String             @default("SERVICE")
  /// Aynı bildirimin iki kez planlanmasını önler (ör. paket:<id>:<bitiş>)
  dedupeKey         String?
  customerId        String?            @db.Uuid
  campaignId        String?            @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, appointmentId])
}

// ---------------------------------------------------------------------
// Kimlik doğrulama: oturumlar, tek kullanımlık belirteçler, 2FA kurtarma kodları
// (kiracıya ait değil; yalnızca platform rolü erişir)
// ---------------------------------------------------------------------
model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  ip          String?
  userAgent   String?
  mfaVerified Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Kayıtlı ödeme yöntemi: yalnızca sağlayıcı belirteci (kart verisi asla saklanmaz).
model SavedPaymentMethod {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  provider  String
  token     String
  label     String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/// Gönderilen e-postaların kaydı. Test modunda gövde saklanır; gerçek modda saklanmaz.
model OutboundEmail {
  id                String    @id @default(uuid()) @db.Uuid
  to                String
  template          String
  subject           String
  body              String?
  status            String
  provider          String
  providerMessageId String?
  dedupeKey         String?   @unique
  error             String?
  /// Yeniden denemek için şablon değişkenleri. Bağlantı/belirteç içeren şablonlarda tutulmaz.
  payload           Json?
  attempts          Int       @default(1)
  lastAttemptAt     DateTime?
  tenantId          String?   @db.Uuid
  /// Owner'ın gönderdiği bilgilendirmelerde gönderen
  actorId           String?   @db.Uuid
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  @@index([to, createdAt])
  @@index([status, createdAt])
}

/// SaaS sahibinin düzenlediği e-posta şablonu metni (konu + paragraflar). Bağlantı butonu sistemce eklenir.
model EmailTemplateOverride {
  name        String   @id
  subject     String
  body        String
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

/// Zamanlanmış görev çalıştırma kaydı (aynı gün ikinci kez çalışmayı önler).
model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  runKey     String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  result     Json?
  error      String?

  @@unique([name, runKey])
}

// ---------------------------------------------------------------------
// İşletme daveti (SaaS sahibi panelinden). Belirteç yalnızca özet (SHA-256) olarak saklanır.
// PENDING_DELIVERY: e-posta gönderilemiyor (canlıda SMTP yok) — belirteç hiç üretilmez.
// ---------------------------------------------------------------------
enum InviteStatus {
  PENDING_DELIVERY
  SENT
  ACCEPTED
  REVOKED
}

model TenantInvite {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  email          String
  fullName       String
  role           Role         @default(OWNER)
  status         InviteStatus @default(PENDING_DELIVERY)
  tokenHash      String?      @unique
  expiresAt      DateTime?
  sentAt         DateTime?
  sendCount      Int          @default(0)
  acceptedAt     DateTime?
  acceptedUserId String?      @db.Uuid
  revokedAt      DateTime?
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([email])
}

// ---------------------------------------------------------------------
// SaaS sahibi muhasebesi (işletmelerin kendi kasasından tamamen ayrı).
// Tablolar yalnızca platform rolüne açıktır; işletme rolü erişemez.
// ---------------------------------------------------------------------

/// SaaS sahibinin şirket bilgileri (tek satır, id = 1). Bilgiler girilene kadar boştur.
model PlatformCompany {
  id               Int      @id @default(1)
  legalName        String?
  address          String?
  /// Vergi kimlik numarası (VKN)
  taxNumber        String?
  taxOffice        String?
  iban             String?
  email            String?
  phone            String?
  website          String?
  /// KDV oranı (%). Girilmeden fatura taslağı oluşturulamaz; varsayılan oran yoktur.
  vatRate          Decimal? @db.Decimal(5, 2)
  /// Paket fiyatları KDV dahil mi? Girilmeden fatura taslağı oluşturulamaz.
  pricesIncludeVat Boolean?
  paymentTermDays  Int      @default(7)
  invoiceNote      String?
  updatedAt        DateTime @updatedAt
  updatedById      String?  @db.Uuid
}

/// İşletmenin fatura bilgileri (SaaS sahibinin müşterisi olarak).
model TenantBillingProfile {
  tenantId  String   @id @db.Uuid
  legalName String
  /// VKN (10 hane) ya da TCKN (11 hane)
  taxNumber String?
  taxOffice String?
  address   String?
  email     String?
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum LedgerEntryType {
  /// Tahakkuk: işletmenin borcu artar
  ACCRUAL
  /// Tahakkuk iptali: tahsil edilmemiş kısım düşülür
  ACCRUAL_CANCEL
  /// Tahsilat: borç azalır
  PAYMENT
  /// İade: tahsil edilen tutar geri ödenir
  REFUND
}

enum LedgerPaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

/// Kiracı cari hesabı. Yalnızca eklenebilir; düzeltme ters kayıtla yapılır.
model PlatformLedgerEntry {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  type           LedgerEntryType
  amount         Decimal              @db.Decimal(12, 2)
  description    String
  occurredAt     DateTime
  dueDate        DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  subscriptionId String?              @db.Uuid
  /// PAYMENT: kapatılan tahakkuk; REFUND: iade edilen tahsilat; ACCRUAL_CANCEL: iptal edilen tahakkuk
  relatedEntryId String?              @db.Uuid
  method         LedgerPaymentMethod?
  reference      String?
  requestId      String               @unique
  actorId        String               @db.Uuid
  createdAt      DateTime             @default(now())

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  related      PlatformLedgerEntry?  @relation("LedgerRelated", fields: [relatedEntryId], references: [id], onDelete: Restrict)
  dependents   PlatformLedgerEntry[] @relation("LedgerRelated")
  invoice      PlatformInvoice?

  @@index([tenantId, occurredAt])
  @@index([relatedEntryId])
}

enum PlatformInvoiceStatus {
  /// Taslak: mali değeri yoktur
  DRAFT
  /// Başka bir sistemde kesilmiş faturanın kaydı (resmî numara elle girilir)
  RECORDED
  /// Yetkili e-Fatura/e-Arşiv entegratörü üzerinden düzenlendi
  ISSUED
  CANCELLED
}

model PlatformInvoice {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  status           PlatformInvoiceStatus @default(DRAFT)
  /// Taslak numarası (TASLAK-2026-000001); resmî fatura numarası değildir
  draftNo          String                @unique
  officialNumber   String?               @unique
  issueDate        DateTime?
  seller           Json
  buyer            Json
  currency         String                @default("TRY")
  vatRate          Decimal               @db.Decimal(5, 2)
  pricesIncludeVat Boolean
  netTotal         Decimal               @db.Decimal(12, 2)
  vatTotal         Decimal               @db.Decimal(12, 2)
  grossTotal       Decimal               @db.Decimal(12, 2)
  note             String?
  accrualId        String?               @unique @db.Uuid
  provider         String?
  providerRef      String?
  cancelledAt      DateTime?
  cancelReason     String?
  createdById      String                @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accrual PlatformLedgerEntry?  @relation(fields: [accrualId], references: [id], onDelete: Restrict)
  lines   PlatformInvoiceLine[]

  @@index([tenantId, createdAt])
}

model PlatformInvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  netAmount   Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @db.Decimal(12, 2)
  grossAmount Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

/// Doğrulanmamış ücretsiz deneme başvurusu. E-posta doğrulanınca kullanıcı + işletme oluşturulur ve kayıt silinir.
/// Parola yalnızca bcrypt özeti olarak, doğrulama belirteci yalnızca SHA-256 özeti olarak tutulur.
model SignupRequest {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  businessName      String
  fullName          String
  /// Normalleştirilmiş telefon (+90XXXXXXXXXX)
  phone             String
  passwordHash      String
  planCode          String
  kvkkNoticeVersion String
  termsVersion      String
  marketingConsent  Boolean  @default(false)
  tokenHash         String   @unique
  expiresAt         DateTime
  ip                String?
  userAgent         String?
  createdAt         DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

/// Kayıt kapalıyken siteden gelen deneme başvurusu. SaaS sahibi onaylayınca işletme + sahip daveti oluşturulur.
enum TrialApplicationStatus {
  /// E-posta doğrulanmadı; Owner listesinde görünmez, süresi dolunca silinir
  UNVERIFIED
  /// E-posta doğrulandı; SaaS sahibinin onayını bekliyor
  PENDING
  APPROVED
  REJECTED
}

/// Herkese açık deneme başvurusu (parola tutulmaz; hesap onaydan sonra davetle açılır). Yalnız platform rolü erişir.
model TrialApplication {
  id                String                 @id @default(uuid()) @db.Uuid
  status            TrialApplicationStatus @default(UNVERIFIED)
  businessName      String
  fullName          String
  /// Küçük harfe çevrilmiş
  email             String
  /// Normalleştirilmiş telefon (+90XXXXXXXXXX)
  phone             String
  city              String?
  staffCount        Int?
  planCode          String?
  note              String?
  kvkkNoticeVersion String
  termsVersion      String
  marketingConsent  Boolean                @default(false)
  /// Yalnızca doğrulama için (tek kullanımlık); doğrulanınca silinir
  tokenHash         String?                @unique
  expiresAt         DateTime?
  verifiedAt        DateTime?
  decidedAt         DateTime?
  decidedById       String?                @db.Uuid
  rejectReason      String?
  tenantId          String?                @db.Uuid
  tenant            Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  ip                String?
  userAgent         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
  @@index([expiresAt])
}

enum ConsentType {
  /// KVKK aydınlatma metninin okunduğu (bilgilendirme; açık rıza değildir)
  KVKK_NOTICE
  /// Kullanım koşullarının kabulü
  TERMS
  /// Ticari elektronik ileti onayı (isteğe bağlı)
  MARKETING
}

/// Kullanıcı onay/bildirim kayıtları: değiştirilmez, yalnızca eklenir.
model UserConsent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  type      ConsentType
  granted   Boolean
  /// Onaylanan metnin sürümü/yolu (ör. /kvkk@2026-10-30)
  version   String
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

// ---------------------------------------------------------------------
// Mesajlaşma kanalları (işletmenin kendi WhatsApp / Instagram hesabı),
// gelen kutusu ve kampanyalar
// ---------------------------------------------------------------------
enum ChannelType {
  WHATSAPP
  INSTAGRAM
}

enum ChannelStatus {
  /// Bilgiler girildi, Meta ile doğrulanmadı
  DRAFT
  /// Meta API ile doğrulandı
  CONNECTED
  /// Son doğrulama/gönderim hatalı
  ERROR
  /// İşletme bağlantıyı kapattı
  DISABLED
}

model ChannelConnection {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  channel           ChannelType
  status            ChannelStatus @default(DRAFT)
  /// WhatsApp: phone_number_id · Instagram: profesyonel hesap kimliği (IG ID)
  externalId        String
  /// WhatsApp Business hesap kimliği (WABA ID), şablon durumu için
  businessAccountId String?
  /// Doğrulamada Meta'dan okunan numara veya @kullanıcı adı
  displayName       String?
  /// AES-256-GCM ile şifreli erişim anahtarı; API yanıtlarında asla dönmez
  accessTokenEnc    String
  tokenLast4        String
  /// Meta uygulama gizli anahtarı (webhook imzası), şifreli
  appSecretEnc      String
  /// Webhook doğrulama belirteci (Meta panelinde girilir); şifreli
  verifyTokenEnc    String
  verifiedAt        DateTime?
  webhookVerifiedAt DateTime?
  lastWebhookAt     DateTime?
  lastError         String?
  /// Gelen mesajlara yapay zekâ otomatik yanıt verir mi?
  aiAutoReply       Boolean       @default(false)
  /// Müşteri mesajlarının yapay zekâ sağlayıcısına (yurt dışı) aktarımı için işletme onayı
  aiDataConsentAt   DateTime?
  aiDataConsentBy   String?       @db.Uuid
  /// ProGüzellik Meta uygulaması üzerinden (Embedded Signup) bağlandı: uygulama sırrı ve webhook adresi ortak
  managed           Boolean       @default(false)
  /// Numaranın iki adımlı doğrulama PIN'i (Cloud API kaydı), şifreli
  pinEnc            String?
  createdById       String?       @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  conversations Conversation[]

  @@unique([tenantId, id])
  @@unique([tenantId, channel])
  @@index([channel, externalId])
}

enum ConversationMode {
  /// Yapay zekâ yanıtlar
  AI
  /// Personel devraldı; yapay zekâ yanıt vermez
  HUMAN
}

model Conversation {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  connectionId   String           @db.Uuid
  channel        ChannelType
  /// WhatsApp: telefon (wa_id) · Instagram: kapsamlı kullanıcı kimliği (IGSID)
  externalUserId String
  displayName    String?
  customerId     String?          @db.Uuid
  mode           ConversationMode @default(AI)
  handoffReason  String?
  /// Meta 24 saat kuralı: serbest metin yalnızca son gelen mesajdan sonraki 24 saatte
  lastInboundAt  DateTime?
  lastMessageAt  DateTime         @default(now())
  unread         Int              @default(0)
  /// Sohbet motorunun ara durumu (onay bekleyen randevu vb.)
  state          Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  connection ChannelConnection     @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Cascade)
  messages   ConversationMessage[]

  @@unique([tenantId, id])
  @@unique([connectionId, externalUserId])
  @@index([tenantId, lastMessageAt])
}

enum MessageDirection {
  IN
  OUT
}

enum MessageAuthor {
  CUSTOMER
  AI
  STAFF
  SYSTEM
}

model ConversationMessage {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  conversationId    String             @db.Uuid
  direction         MessageDirection
  author            MessageAuthor
  text              String
  /// Meta mesaj kimliği (wamid / mid); tekrar gelen webhook'lar bununla elenir
  providerMessageId String?            @unique
  status            NotificationStatus @default(QUEUED)
  error             String?
  staffUserId       String?            @db.Uuid
  createdAt         DateTime           @default(now())

  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
}

model Campaign {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  title       String
  /// Müşteriye anlatılacak metin (yapay zekâ yalnızca bunu kullanır)
  description String
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, isActive])
}

// ---------------------------------------------------------------------
// PWA V1.0: salon PWA ayarları, müşteri portalı kimliği, Web Push, uygulama içi bildirimler
// ---------------------------------------------------------------------

/// İşletme başına PWA özellik bayrakları (yalnız SaaS sahibi açar; varsayılan kapalı) ve salon markası (işletme düzenler).
model TenantPwaSettings {
  tenantId                       String    @id @db.Uuid
  businessPwaEnabled             Boolean   @default(false)
  customerPwaEnabled             Boolean   @default(false)
  customerBookingEnabled         Boolean   @default(false)
  webPushEnabled                 Boolean   @default(false)
  customerSessionTrackingEnabled Boolean   @default(false)
  flagsUpdatedById               String?   @db.Uuid
  flagsUpdatedAt                 DateTime?
  /// Müşterinin portaldan iptal/değişiklik yapabileceği en geç süre (randevuya kalan saat)
  cancelMinHours                 Int       @default(2)
  rescheduleMinHours             Int       @default(2)
  allowCustomerCancel            Boolean   @default(true)
  allowCustomerReschedule        Boolean   @default(true)
  appName                        String?
  shortName                      String?
  description                    String?
  primaryColor                   String?
  secondaryColor                 String?
  logoAssetId                    String?   @db.Uuid
  iconAssetId                    String?   @db.Uuid
  updatedAt                      DateTime  @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// İşletmenin yüklediği görseller (logo, uygulama simgesi). Yalnızca PNG/JPEG/WebP, boyut sınırlı.
model TenantAsset {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  kind        String
  mime        String
  bytes       Bytes
  width       Int
  height      Int
  sha256      String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
}

/// Müşteri portalında e-posta koduyla doğrulanmış kimlik (işletme başına ayrı).
model CustomerIdentity {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  email                  String
  verifiedAt             DateTime
  notifyAppointments     Boolean                 @default(true)
  notifyReminders        Boolean                 @default(true)
  lastSeenAt             DateTime?
  createdAt              DateTime                @default(now())
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  customerPortalSessions CustomerPortalSession[]
  pushSubscriptions      PushSubscription[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
}

/// Tek kullanımlık doğrulama kodu (yalnız özeti saklanır).
model CustomerOtp {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  channel     String    @default("EMAIL")
  destination String
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, destination, createdAt])
}

model CustomerPortalSession {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  identityId String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  createdAt  DateTime  @default(now())

  identity CustomerIdentity @relation(fields: [tenantId, identityId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, identityId])
}

/// Web Push aboneliği: bir cihaz/tarayıcı, bir işletme ve tek bir kişiye (personel kullanıcısı veya müşteri kimliği) bağlıdır.
model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  audience      String
  userId        String?   @db.Uuid
  identityId    String?   @db.Uuid
  endpoint      String
  p256dh        String
  auth          String
  userAgent     String?
  failures      Int       @default(0)
  lastSuccessAt DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  identity CustomerIdentity? @relation(fields: [tenantId, identityId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, endpoint])
  @@index([tenantId, userId])
  @@index([tenantId, identityId])
}

/// İşletme kullanıcısının bildirim tercihleri (işletme başına).
model UserNotificationPreference {
  tenantId        String   @db.Uuid
  userId          String   @db.Uuid
  newAppointments Boolean  @default(true)
  cancellations   Boolean  @default(true)
  changes         Boolean  @default(true)
  assignments     Boolean  @default(true)
  updatedAt       DateTime @default(now()) @updatedAt

  @@id([tenantId, userId])
}

/// Uygulama içi bildirim merkezi kaydı (yalnız ilgili kişi görür).
model InAppNotification {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  audience      String
  userId        String?   @db.Uuid
  identityId    String?   @db.Uuid
  type          String
  title         String
  body          String
  appointmentId String?   @db.Uuid
  readAt        DateTime?
  dedupeKey     String
  createdAt     DateTime  @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, identityId, createdAt])
}

/// iyzico Abonelik: onaylı fiyat sürümü + dönem için iyzico'da açılan ödeme planı (KDV dahil tutarla).
/// Fiyat değişince yeni sürüm → yeni iyzico planı; mevcut aboneler eski planda kalır.
model IyzicoPlanLink {
  id                       String       @id @default(uuid()) @db.Uuid
  /// "sandbox" | "live"
  environment              String
  planCode                 String
  planPriceId              String       @db.Uuid
  billingCycle             BillingCycle
  productReferenceCode     String
  pricingPlanReferenceCode String       @unique
  /// iyzico'nun karttan çektiği tutar (KDV dahil)
  grossAmount              Decimal      @db.Decimal(12, 2)
  createdAt                DateTime     @default(now())

  @@unique([environment, planPriceId, billingCycle])
}

enum IyzicoCheckoutStatus {
  PENDING
  COMPLETED
  FAILED
}

/// iyzico ödeme formu oturumu. Kart bilgisi hiç tutulmaz; yalnız iyzico belirteci ve referanslar.
model IyzicoCheckout {
  id                        String               @id @default(uuid()) @db.Uuid
  /// Mevcut işletmenin ödemesinde dolu. Siteden satın almada ödeme başarılı olana dek boş (işletme henüz yok).
  tenantId                  String?              @db.Uuid
  userId                    String?              @db.Uuid
  /// Siteden doğrudan satın alma: bekleyen satın alma kaydı (tenantId ya da bu alan dolu olmalı)
  purchaseRequestId         String?              @db.Uuid
  environment               String
  conversationId            String               @unique
  token                     String?              @unique
  planCode                  String
  billingCycle              BillingCycle
  planPriceId               String               @db.Uuid
  netAmount                 Decimal              @db.Decimal(12, 2)
  vatRate                   Decimal              @db.Decimal(5, 2)
  grossAmount               Decimal              @db.Decimal(12, 2)
  pricingPlanReferenceCode  String
  status                    IyzicoCheckoutStatus @default(PENDING)
  subscriptionReferenceCode String?
  customerReferenceCode     String?
  error                     String?
  subscriptionId            String?              @db.Uuid
  createdAt                 DateTime             @default(now())
  completedAt               DateTime?

  @@index([tenantId, createdAt])
  @@index([purchaseRequestId])
}

/// Siteden doğrudan paket satın alma (deneme olmadan). İşletme ve kullanıcı yalnız ilk ödeme
/// iyzico'da doğrulanınca oluşturulur; o anda bu kayıt silinir. Fatura bilgileri burada tutulmaz (yalnız iyzico'ya gider).
model PurchaseRequest {
  id                String       @id @default(uuid()) @db.Uuid
  /// Küçük harfe çevrilmiş
  email             String
  businessName      String
  fullName          String
  /// Normalleştirilmiş telefon (+90XXXXXXXXXX)
  phone             String
  passwordHash      String
  planCode          String
  billingCycle      BillingCycle
  kvkkNoticeVersion String
  termsVersion      String
  marketingConsent  Boolean      @default(false)
  /// E-posta bağlantısındaki belirtecin özeti; ödeme adımına kadar aynı bağlantı kullanılır
  tokenHash         String       @unique
  expiresAt         DateTime
  verifiedAt        DateTime?
  /// Bu kayıtla başlatılan ödeme formu sayısı (kötüye kullanım sınırı)
  checkoutCount     Int          @default(0)
  ip                String?
  userAgent         String?
  createdAt         DateTime     @default(now())

  @@index([email])
  @@index([phone])
  @@index([expiresAt])
}

/// iyzico abonelik bildirimleri (webhook). Aynı bildirim iki kez işlenmez.
model IyzicoWebhookEvent {
  id                        String    @id @default(uuid()) @db.Uuid
  iyziReferenceCode         String    @unique
  eventType                 String
  subscriptionReferenceCode String
  orderReferenceCode        String
  receivedAt                DateTime  @default(now())
  processedAt               DateTime?
  result                    String?
}

// ---------------------------------------------------------------------
// Ürün satış fişi: birden çok satır, satan personel, kasa kaydı.
// Fiş ve satırlar değiştirilemez; iadeler ProductSaleReturn ile eklenir.
// ---------------------------------------------------------------------
model ProductSale {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @db.Uuid
  customerId           String?       @db.Uuid
  staffId              String?       @db.Uuid
  financeTransactionId String        @db.Uuid
  method               PaymentMethod
  total                Decimal       @db.Decimal(12, 2)
  /// Fişteki toplam KDV (KDV dahil toplamın içinde)
  vatTotal             Decimal       @default(0) @db.Decimal(12, 2)
  /// Randevu tahsilatıyla birlikte satıldıysa
  appointmentId        String?       @db.Uuid
  note                 String?
  createdById          String?       @db.Uuid
  occurredAt           DateTime      @default(now())

  customer    Customer?           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  staff       StaffMember?        @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  appointment Appointment?        @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  transaction FinanceTransaction  @relation(fields: [tenantId, financeTransactionId], references: [tenantId, id], onDelete: Restrict)
  items       ProductSaleItem[]
  returns     ProductSaleReturn[]
  movements   StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, financeTransactionId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, staffId, occurredAt])
}

model ProductSaleItem {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  saleId    String   @db.Uuid
  productId String   @db.Uuid
  qty       Decimal  @db.Decimal(12, 3)
  unitPrice Decimal  @db.Decimal(12, 2)
  /// Satış anındaki alış fiyatı (kâr raporu için)
  unitCost  Decimal? @db.Decimal(12, 2)
  /// KDV dahil satır tutarı
  lineTotal Decimal  @db.Decimal(12, 2)
  /// Satış anındaki KDV oranı (tanımsızsa null) ve satır içindeki KDV tutarı
  vatRate   Decimal? @db.Decimal(5, 2)
  vatAmount Decimal  @default(0) @db.Decimal(12, 2)

  sale    ProductSale             @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  product Product                 @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  returns ProductSaleReturnLine[]

  @@unique([tenantId, id])
  @@index([tenantId, saleId])
  @@index([tenantId, productId])
}

model ProductSaleReturn {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  saleId              String   @db.Uuid
  refundTransactionId String   @db.Uuid
  amount              Decimal  @db.Decimal(12, 2)
  reason              String
  createdById         String?  @db.Uuid
  createdAt           DateTime @default(now())

  sale        ProductSale             @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  transaction FinanceTransaction      @relation(fields: [tenantId, refundTransactionId], references: [tenantId, id], onDelete: Restrict)
  lines       ProductSaleReturnLine[]

  @@unique([tenantId, id])
  @@index([tenantId, saleId])
  @@index([tenantId, createdAt])
}

model ProductSaleReturnLine {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  returnId   String  @db.Uuid
  saleItemId String  @db.Uuid
  qty        Decimal @db.Decimal(12, 3)
  amount     Decimal @db.Decimal(12, 2)
  vatAmount  Decimal @default(0) @db.Decimal(12, 2)
  /// Ürün stoğa geri alındı mı (hasarlı ürün geri alınmayabilir)
  restocked  Boolean

  ret      ProductSaleReturn @relation(fields: [tenantId, returnId], references: [tenantId, id], onDelete: Restrict)
  saleItem ProductSaleItem   @relation(fields: [tenantId, saleItemId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, saleItemId])
}
