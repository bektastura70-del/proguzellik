# ProGüzellik canlı ortam değişkenleri — /opt/proguzellik/.env (izin 600, sahibi root).
# Gerçek değerleri ASLA depoya koymayın. Tüm parolalar/anahtarlar: openssl rand -hex 32
# (yalnızca hex: veritabanı/Redis adreslerinde özel karakter sorunu çıkmaz)

# Dağıtılan imaj etiketi (git commit kısaltması). Geri dönüşte önceki etikete çevrilir.
APP_VERSION=

PUBLIC_URL=https://proguzellik.com

# PostgreSQL migration sahibi (yalnızca postgres ve migrate servislerine verilir)
PG_OWNER_USER=proguzellik_owner
PG_OWNER_PASSWORD=
PG_DB=proguzellik

# Uygulama rolleri (migration'lar NOLOGIN oluşturur; set-db-role-passwords.sh giriş izni verir)
APP_TENANT_DB_PASSWORD=
APP_PLATFORM_DB_PASSWORD=

REDIS_PASSWORD=

# Değiştirilirse tüm oturumlar düşer
JWT_SECRET=
# DİKKAT: değiştirilir/kaybedilirse mevcut 2FA kayıtları çözülemez. Sunucu dışında ayrıca yedekleyin.
MFA_ENCRYPTION_KEY=

# Herkese açık işletme kaydı (7 gün ücretsiz deneme). Başlangıçta kapalı (0).
# Açmadan önce e-posta (SMTP) çalışır olmalı: doğrulama e-postası gidemezse başvuru alınmaz (503).
# Ayrıca Caddy snippet'indeki kayıt engeli kaldırılmalıdır.
REGISTRATION_ENABLED=0

# Paket fiyatları. Boş bırakın (önerilen): sitede ve işletme panelinde yalnız /platform → Paketler'de
# parola + 2FA ile onaylanmış fiyatlar görünür (KDV hariç); onaylı fiyatı olmayan pakette "Fiyat yakında" yazar.
# 0 = acil durum: onaylı olsa bile tüm tutarlar gizlenir. 1 = ayrıca online satın alma/otomatik yenileme açık
# (canlıda ödeme sağlayıcısı olmadan kullanmayın).
PRICING_PUBLIC=

# Kurumsal e-posta. mock: gönderim YOK (davet/doğrulama/sıfırlama e-postaları gitmez, "gönderilmedi" kaydı tutulur).
# smtp için: SMTP_URL=smtps://KULLANICI:PAROLA@smtp.saglayici.com:465 ve COMPOSE_FILE'a docker-compose.egress.yml
EMAIL_MODE=mock
SMTP_URL=
EMAIL_FROM=ProGüzellik <info@proguzellik.com>
SUPPORT_EMAIL=info@proguzellik.com

# Compose dosyaları. İlk kurulumda yalnızca ana dosya (ortak ağa bağlanmaz).
# Yayına alırken: COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# SMTP açıkken:   COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml:docker-compose.egress.yml
COMPOSE_FILE=docker-compose.yml
# Ortak ters vekil ağı (edge-caddy)
EDGE_NETWORK=edge_proxy
