{
  "appId": "com.proguzellik.app",
  "appName": "Pro Güzellik",
  "webDir": "www",
  "appendUserAgent": "ProGuzellikApp/1.0.0",
  "backgroundColor": "#faf8f5",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "proguzellik.com",
      "www.proguzellik.com"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#faf8f5",
      "showSpinner": false
    },
    "LocalNotifications": {
      "iconColor": "#933c63"
    }
  }
}
